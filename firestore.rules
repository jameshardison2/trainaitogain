rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{document=**} {
      // Anyone can create a lead (submit the form)
      allow create: if true;
      // Anyone can read leads (for affiliate dashboard)
      allow read: if true;
      // Allow updates to status, but prevent changing the owner
      allow update: if request.resource.data.referred_by == resource.data.referred_by;
      allow delete: if false;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
