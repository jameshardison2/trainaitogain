{
  "manifest_version": 3,
  "name": "Get You Hired Extension",
  "version": "3.2",
  "description": "Your auto-pilot for bypassing AI filters.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://work.mercor.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://work.mercor.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.svg"],
      "matches": ["*://work.mercor.com/*"]
    }
  ]
}
