{
  "manifest_version": 3,
  "name": "Get You Hired Extension",
  "version": "3.2",
  "description": "Your auto-pilot for bypassing AI filters.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mercor.com/*",
    "*://trainaitogain.com/*",
    "*://*.trainaitogain.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercor.com/*",
        "*://trainaitogain.com/*",
        "*://*.trainaitogain.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.svg"],
      "matches": [
        "*://*.mercor.com/*",
        "*://trainaitogain.com/*",
        "*://*.trainaitogain.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
