{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/extension-download",
        "destination": "/guide-download.html",
        "type": 301
      },
      {
        "source": "/wali",
        "destination": "/?ref=wali",
        "type": 301
      },
      {
        "source": "/reed",
        "destination": "/?ref=reed",
        "type": 301
      },
      {
        "source": "/reed-promo",
        "destination": "/landing_page_v2.html?ref=reed",
        "type": 301
      }
    ]
  }
}
