{
  "hosting": {
    "target": "app",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/venv/**",
      "backend/**"
    ],
    "rewrites": [
      {
        "source": "/api/generateAiResponse",
        "function": "generateAiResponse"
      },
      {
        "source": "/api/directIngestJobs",
        "function": "directIngestJobs"
      },
      {
        "source": "/api/getRoles",
        "function": "getRoles"
      },
      {
        "source": "/api/logPipelineEvent",
        "function": "logPipelineEvent"
      }
    ],
    "headers": [
      {
        "source": "**/*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/hiring-pipeline",
        "destination": "/resume-ats-guide",
        "type": 301
      },
      {
        "source": "/hiring-pipeline.html",
        "destination": "/resume-ats-guide",
        "type": 301
      },
      {
        "source": "/guide-download",
        "destination": "/trainaitogain-hiring-blueprint.pdf",
        "type": 301
      },
      {
        "source": "/linkedin",
        "destination": "/?utm_source=linkedin&utm_medium=post",
        "type": 301
      },
      {
        "source": "/dm",
        "destination": "/?utm_source=linkedin&utm_medium=dm",
        "type": 301
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  }
}
