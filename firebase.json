{
  "hosting": {
    "target": "app",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/venv/**",
      "backend/**"
    ],
    "rewrites": [
      {
        "source": "/api/generateAiResponse",
        "function": "generateAiResponse"
      },
      {
        "source": "/api/directIngestJobs",
        "function": "directIngestJobs"
      },
      {
        "source": "/api/getRoles",
        "function": "getRoles"
      },
      {
        "source": "/api/logPipelineEvent",
        "function": "logPipelineEvent"
      },
      {
        "source": "/api/sendMockResultsEmail",
        "function": "sendMockResultsEmail"
      },
      {
        "source": "/api/subscribeRoleAlerts",
        "function": "subscribeRoleAlerts"
      },
      {
        "source": "/api/sendRoleAlertsDigest",
        "function": "sendRoleAlertsDigest"
      },
      {
        "source": "/api/recordUnsubscribe",
        "function": "recordUnsubscribe"
      },
      {
        "source": "/api/setRoleReminder",
        "function": "setRoleReminder"
      },
      {
        "source": "/api/processRoleReminders",
        "function": "processRoleReminders"
      },
      {
        "source": "/api/getScoreboard",
        "function": "getScoreboard"
      },
      {
        "source": "/api/saveScoreboard",
        "function": "saveScoreboard"
      }
    ],
    "headers": [
      {
        "source": "**/*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/hiring-pipeline",
        "destination": "/resume-ats-guide",
        "type": 301
      },
      {
        "source": "/hiring-pipeline.html",
        "destination": "/resume-ats-guide",
        "type": 301
      },
      {
        "source": "/interview-prep",
        "destination": "/ai-interview",
        "type": 301
      },
      {
        "source": "/interview-prep.html",
        "destination": "/ai-interview",
        "type": 301
      },
      {
        "source": "/guide-download",
        "destination": "/trainaitogain-hiring-blueprint.pdf",
        "type": 301
      },
      {
        "source": "/linkedin",
        "destination": "/?utm_source=linkedin&utm_medium=post",
        "type": 301
      },
      {
        "source": "/dm",
        "destination": "/?utm_source=linkedin&utm_medium=dm",
        "type": 301
      },
      {
        "source": "/go/:campaign",
        "destination": "/resume-ats-guide?utm_source=linkedin&utm_medium=dm&utm_campaign=:campaign",
        "type": 302
      },
      {
        "source": "/p/:campaign",
        "destination": "/ai-interview?utm_source=linkedin&utm_medium=dm&utm_campaign=:campaign",
        "type": 302
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "TrainAIToGain",
        "supportEmail": "trainaitogain@gmail.com",
        "authorizedRedirectUris": [
          "https://trainaitogain.com/__/auth/handler",
          "https://www.trainaitogain.com/__/auth/handler",
          "https://trainaitogain-50c19--round4-preview-dntt6qfk.web.app/__/auth/handler"
        ]
      }
    }
  }
}
